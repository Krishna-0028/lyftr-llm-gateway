# Backend configuration
LLM_API_KEYS=your-primary-api-key,your-secondary-api-key
LLM_MODEL=gemini/gemini-2.0-flash
# Optional: comma-separated per-key models (defaults to LLM_MODEL for every key)
# LLM_MODELS=gemini/gemini-2.0-flash,gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_FAILURE_SIMULATION=true
CACHE_TYPE=local
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# Frontend configuration
VITE_API_BASE_URL=http://localhost:8000
